#!/bin/bash
# vgm — 在 Apple Silicon Mac 上玩 Steam Windows 遊戲的輕量啟動器。
#
# 原理:Windows 遊戲 (x86) ─ Rosetta 2 ─ Wine ─ D3DMetal ─ Metal ─ Apple GPU
# 這支腳本不做任何轉譯,只負責「裝好、設好環境變數、啟動」,所以沒有常駐程式。
# 相容 macOS 內建的 bash 3.2(不使用關聯陣列等新語法)。
set -euo pipefail

# ── 路徑 ────────────────────────────────────────────────────────────────
self="$0"
ME="$0" # 提示訊息裡顯示使用者實際輸入的指令(例如 ./vgm)
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
VGM_ROOT="$(cd "$(dirname "$self")" && pwd)"            # 內建 backends/ profiles/
VGM_HOME="${VGM_HOME:-$HOME/.vgm}"                      # 使用者資料
VGM_CONFIG="${VGM_CONFIG:-$HOME/.config/vgm}"           # 使用者自訂 backends/ profiles/
export WINEPREFIX="${WINEPREFIX:-$VGM_HOME/prefix}"     # 虛擬 C: 槽
STEAM_EXE="$WINEPREFIX/drive_c/Program Files (x86)/Steam/steam.exe"
STEAM_SETUP_URL="https://cdn.cloudflare.steamstatic.com/client/installer/SteamSetup.exe"
# 需要兩樣東西(原因見 README「為什麼要兩個 Wine」):
#   1. Wine 9.0(CrossOver 開源碼的社群編譯版):跑得動新版 64 位元 Steam,也還相容 D3DMetal。
#   2. Game Porting Toolkit cask:只取用裡面的 D3DMetal 與 freetype/gnutls 等函式庫,不用它的 Wine 7.7。
WINE_URL="https://github.com/Sikarugir-App/Engines/releases/download/v1.0/WS12WineCX24.0.7_7.tar.xz"
WINE_SHA256="203f9e9fd6c2cc77e6525d798a434ced326145db34a356355e05659d3445fd1c"
WINE_DIR="$VGM_HOME/wine/cx24"
WINE_CASK="gcenx/wine/game-porting-toolkit"
GPTK="${VGM_GPTK:-/Applications/Game Porting Toolkit.app/Contents/Resources/wine}"
STATE="$VGM_HOME/active-profile"
LOG="$VGM_HOME/logs/last.log"

say() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

# ── Wine ────────────────────────────────────────────────────────────────
# 找可用的 Wine;要用別的版本就設 VGM_WINE=/path/to/wine。
# 不會自動使用 Game Porting Toolkit 內建的 Wine 7.7:新版 Steam 在它上面一啟動就當機。
find_wine() {
  local c
  for c in "${VGM_WINE:-}" "$WINE_DIR/wswine.bundle/bin/wine"; do
    if [ -n "$c" ] && [ -x "$c" ]; then echo "$c"; return 0; fi
  done
  return 1
}

need_wine() {
  WINE="$(find_wine)" || die "找不到 Wine,請先執行:$ME setup"
  WINESERVER="$(dirname "$WINE")/wineserver"
  # 這份 Wine 不自帶 freetype、gnutls 等函式庫,借用 Game Porting Toolkit 裡的。
  # 必須在腳本內設定:macOS 會把經過 /bin/bash 傳進來的 DYLD_* 變數清掉。
  export DYLD_FALLBACK_LIBRARY_PATH="$GPTK/lib:/usr/lib"
}

need_steam() {
  need_wine
  [ -f "$STEAM_EXE" ] || die "尚未安裝 Steam,請先執行:$ME setup"
}

# ── 設定檔 (profile) 與圖形後端 (backend) ───────────────────────────────
# 使用者目錄 ($VGM_CONFIG) 的同名檔案優先於內建檔案。
find_file() { # find_file <子目錄> <檔名>
  local d
  for d in "$VGM_CONFIG" "$VGM_ROOT"; do
    if [ -f "$d/$1/$2" ]; then echo "$d/$1/$2"; return 0; fi
  done
  return 1
}

# 給 backend 用:疊加 DLL 覆寫。
dll_override() { export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}$1"; }

# 給 backend 用:把 DLL 複製進虛擬 C: 槽。
# 目錄內若有 x64/ x32/(DXVK 發行包的結構)就分別安裝,否則全部視為 64 位元。
install_dlls() {
  local src="$1" win="$WINEPREFIX/drive_c/windows"
  [ -d "$src" ] || die "找不到目錄:$src"
  if [ -d "$src/x64" ]; then
    cp "$src"/x64/*.dll "$win/system32/"
    if [ -d "$src/x32" ] && [ -d "$win/syswow64" ]; then cp "$src"/x32/*.dll "$win/syswow64/"; fi
  else
    cp "$src"/*.dll "$win/system32/"
  fi
}

# 先載入 default,再載入指定設定檔(後者覆蓋前者),最後套用後端。
load_profile() {
  local name="$1" f
  BACKEND=d3dmetal HUD=0 STEAM_ARGS="" GAME_ARGS=""
  for f in "$VGM_ROOT/profiles/default.conf" "$VGM_CONFIG/profiles/default.conf"; do
    # shellcheck disable=SC1090
    if [ -f "$f" ]; then . "$f"; fi
  done
  if [ "$name" != default ] && f="$(find_file profiles "$name.conf")"; then
    # shellcheck disable=SC1090
    . "$f"
  fi
  load_backend "$BACKEND"
  backend_env
  if [ "$HUD" = 1 ]; then export MTL_HUD_ENABLED=1; fi
}

load_backend() {
  local f
  f="$(find_file backends "$1.sh")" || die "未知的圖形後端:$1(可用:$(list_backends))"
  backend_env() { :; }
  backend_install() { die "後端 $BACKEND 不需要安裝"; }
  # shellcheck disable=SC1090
  . "$f"
}

list_backends() {
  local d f out=""
  for d in "$VGM_ROOT" "$VGM_CONFIG"; do
    for f in "$d"/backends/*.sh; do
      if [ -f "$f" ]; then out="$out $(basename "$f" .sh)"; fi
    done
  done
  echo "${out# }"
}

# 遊戲會繼承「Steam 啟動當下」的環境變數,所以換設定檔時必須重啟 Steam。
steam_running() { pgrep -f 'steam\.exe' >/dev/null 2>&1; }

activate_profile() {
  local name="$1" active=""
  if [ -f "$STATE" ]; then active="$(cat "$STATE")"; fi
  if [ "$active" != "$name" ] && steam_running; then
    say "設定檔由 ${active:-未知} 切換為 $name,重新啟動 Steam…"
    "$WINESERVER" -k || true
    "$WINESERVER" -w || true
  fi
  mkdir -p "$VGM_HOME"
  echo "$name" >"$STATE"
}

# ── 啟動 ────────────────────────────────────────────────────────────────
launch() { # launch <exe> [參數...]
  export WINEESYNC=1 WINEMSYNC=1      # 以 macOS 原生同步機制取代 wineserver 往返
  export ROSETTA_ADVERTISE_AVX=1      # 讓遊戲看得到 AVX/AVX2(需 macOS 15 以上)
  # 預設關閉 Wine 除錯輸出(對效能有實質影響);VGM_DEBUG=1 時保留,方便找問題
  if [ "${VGM_DEBUG:-0}" != 1 ]; then export WINEDEBUG="${WINEDEBUG:--all}"; fi
  mkdir -p "$VGM_HOME/logs"
  local code=0
  # 先清空再用附加模式寫入:還在背景跑的 Steam 也握著這個檔案,不用附加模式會寫出一大段空洞
  : >"$LOG"
  "$WINE" "$@" >>"$LOG" 2>&1 || code=$?
  if [ $code = 42 ]; then
    # Steam 自我更新時,原本的行程會以代碼 42 結束,新的 Steam 在背景接手,不是錯誤
    say "Steam 正在自我更新,完成後視窗會自己出現(第一次約需幾分鐘)"
    return 0
  fi
  if [ $code != 0 ]; then
    warn "程式異常結束(代碼 $code),最後的輸出:"
    tail -n 20 "$LOG" >&2
    warn "完整紀錄:$LOG(用 VGM_DEBUG=1 重跑可取得更詳細的內容)"
  fi
  return $code
}

# ── 指令 ────────────────────────────────────────────────────────────────
cmd_doctor() {
  local ok=0 wine r
  check() { # check <說明> <是否通過 0/1> [未通過時的提示]
    if [ "$2" = 0 ]; then printf '  \033[32m✓\033[0m %s\n' "$1"
    else printf '  \033[31m✗\033[0m %s%s\n' "$1" "${3:+ — $3}"; ok=1; fi
  }
  [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ] && r=0 || r=1
  check "Apple Silicon Mac" $r "僅支援 M 系列晶片的 Mac"
  if [ $r = 0 ]; then
    local ver; ver="$(sw_vers -productVersion)"
    [ "${ver%%.*}" -ge 15 ] && r=0 || r=1
    check "macOS $ver" $r "建議升級到 macOS 15 以上(AVX 支援)"
    arch -x86_64 /usr/bin/true 2>/dev/null && r=0 || r=1
    check "Rosetta 2" $r "執行 $ME setup"
  fi
  wine="$(find_wine)" && r=0 || r=1
  check "Wine${wine:+:$wine}" $r "執行 $ME setup"
  [ -d "$GPTK/lib/external/D3DMetal.framework" ] && r=0 || r=1
  check "D3DMetal(Game Porting Toolkit)" $r "執行 $ME setup"
  [ -f "$WINEPREFIX/system.reg" ] && r=0 || r=1
  check "Wine 環境:$WINEPREFIX" $r "執行 $ME setup"
  [ -f "$STEAM_EXE" ] && r=0 || r=1
  check "Windows 版 Steam" $r "執行 $ME setup"
  echo "  圖形後端:$(list_backends)"
  return $ok
}

cmd_setup() {
  [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ] || die "僅支援 Apple Silicon Mac"

  if ! arch -x86_64 /usr/bin/true 2>/dev/null; then
    say "安裝 Rosetta 2…"
    softwareupdate --install-rosetta --agree-to-license
  fi

  if [ ! -d "$GPTK/lib/external/D3DMetal.framework" ]; then
    command -v brew >/dev/null || die "請先安裝 Homebrew (https://brew.sh)"
    say "安裝 Game Porting Toolkit(提供 D3DMetal)…"
    brew install --cask "$WINE_CASK"
  fi

  if ! find_wine >/dev/null; then
    say "下載 Wine 9.0(約 170 MB)…"
    local tar="$VGM_HOME/wine.tar.xz"
    mkdir -p "$WINE_DIR"
    curl -fL --progress-bar -o "$tar" "$WINE_URL"
    [ "$(shasum -a 256 "$tar" | cut -d' ' -f1)" = "$WINE_SHA256" ] || die "下載的 Wine 檢查碼不符,已保留在 $tar"
    tar -xf "$tar" -C "$WINE_DIR"
    rm -f "$tar"
  fi
  need_wine

  if [ ! -f "$WINEPREFIX/system.reg" ]; then
    say "建立 Wine 環境:$WINEPREFIX"
    mkdir -p "$WINEPREFIX"
    WINEDEBUG=-all "$WINE" wineboot -u
    # Steam 需要 Windows 10 以上
    WINEDEBUG=-all "$WINE" reg add 'HKCU\Software\Wine' /v Version /t REG_SZ /d win10 /f >/dev/null
    "$WINESERVER" -w
  fi

  if [ ! -f "$STEAM_EXE" ]; then
    say "下載並安裝 Windows 版 Steam…"
    local installer="$VGM_HOME/SteamSetup.exe"
    curl -fL --progress-bar -o "$installer" "$STEAM_SETUP_URL"
    WINEDEBUG=-all "$WINE" "$installer" /S
    "$WINESERVER" -w
    [ -f "$STEAM_EXE" ] || die "Steam 安裝失敗,安裝檔保留在 $installer,可用 vgm wine \"$installer\" 手動安裝"
    rm -f "$installer"
  fi

  say "完成!執行 $ME steam 開啟 Steam。"
}

cmd_steam() {
  need_steam
  load_profile default
  activate_profile default
  # shellcheck disable=SC2086
  launch "$STEAM_EXE" $STEAM_ARGS "$@"
}

cmd_play() {
  local appid="${1:-}" profile=default
  [[ "$appid" =~ ^[0-9]+$ ]] || die "用法:vgm play <appid> [遊戲參數...](appid 可用 vgm list 查詢)"
  shift
  need_steam
  if find_file profiles "$appid.conf" >/dev/null; then profile="$appid"; fi
  load_profile "$profile"
  activate_profile "$profile"
  # shellcheck disable=SC2086
  launch "$STEAM_EXE" $STEAM_ARGS -applaunch "$appid" $GAME_ARGS "$@"
}

# 不經 Steam 直接執行 exe(免 DRM 的遊戲、安裝程式、工具)。
cmd_run() {
  local profile=default
  if [ "${1:-}" = -p ]; then profile="${2:-}"; shift 2 || die "用法:vgm run [-p 設定檔] <exe> [參數...]"; fi
  [ -n "${1:-}" ] || die "用法:vgm run [-p 設定檔] <exe> [參數...]"
  need_wine
  load_profile "$profile"
  launch "$@"
}

cmd_list() {
  local f found=0
  for f in "$(dirname "$STEAM_EXE")"/steamapps/appmanifest_*.acf; do
    [ -f "$f" ] || continue
    found=1
    printf '%-10s %s\n' \
      "$(sed -n 's/^[[:space:]]*"appid"[[:space:]]*"\(.*\)"/\1/p' "$f")" \
      "$(sed -n 's/^[[:space:]]*"name"[[:space:]]*"\(.*\)"/\1/p' "$f")"
  done
  [ $found = 1 ] || warn "還沒有安裝任何遊戲(只會列出預設收藏庫)"
}

cmd_backend() {
  case "${1:-list}" in
    list) list_backends | tr ' ' '\n' ;;
    install)
      [ -n "${2:-}" ] || die "用法:vgm backend install <名稱> [DLL 目錄]"
      need_wine
      BACKEND="$2"
      load_backend "$2"
      backend_install "${3:-}"
      say "已安裝後端 $2;在設定檔寫入 BACKEND=$2 即可啟用"
      ;;
    *) die "用法:vgm backend [list | install <名稱> [DLL 目錄]]" ;;
  esac
}

# 診斷用:列出還在跑的 Windows 程式與上次啟動的紀錄,回報問題時貼這個。
cmd_log() {
  say "執行中的 Windows 程式:"
  pgrep -fl '\.exe' || echo "  (沒有)"
  say "上次啟動的紀錄 ($LOG):"
  if [ -f "$LOG" ]; then tail -n "${1:-60}" "$LOG"; else echo "  (沒有)"; fi
}

cmd_kill() { need_wine; "$WINESERVER" -k || true; rm -f "$STATE"; say "已關閉所有 Windows 程式"; }

cmd_wine() { need_wine; exec "$WINE" "$@"; }

# ── 移除 ────────────────────────────────────────────────────────────────
# 只碰 vgm 自己建立的東西,每一項都先列出、再逐項確認(-y 全部同意,-n 只列出不刪)。
# 不會動:Rosetta 2、Homebrew 本身、Mac 版 Steam、其他任何檔案。
confirm() { # confirm <問題>;回傳 0 表示同意
  local a
  if [ "$UN_MODE" = dry ]; then echo "  (試跑,未執行)"; return 1; fi
  if [ "$UN_MODE" = yes ]; then return 0; fi
  printf '  %s [y/N] ' "$1"
  read -r a || a=""
  case "$a" in y | Y | yes) return 0 ;; *) echo "  略過"; return 1 ;; esac
}

# 只允許刪除「家目錄底下、至少兩層深、不是符號連結」的目錄,其餘一律拒絕。
remove_dir() { # remove_dir <目錄> <說明>
  local d="$1" real
  [ -e "$d" ] || return 0
  say "$2:$d($(du -sh "$d" 2>/dev/null | cut -f1))"
  if [ -L "$d" ] || [ ! -d "$d" ]; then warn "不是一般目錄,為安全起見不處理"; return 0; fi
  real="$(cd "$d" && pwd -P)"
  case "$(basename "$real")" in
    *vgm*) ;;
    *) warn "目錄名稱不含 vgm,為安全起見不處理"; return 0 ;;
  esac
  case "$real" in
    "$HOME_REAL"/*/* | "$HOME_REAL"/.[!.]*) ;;
    *) warn "不在家目錄底下或層級太淺,為安全起見不處理"; return 0 ;;
  esac
  if confirm "刪除?"; then rm -rf "$real" && echo "  已刪除"; fi
}

cmd_uninstall() {
  UN_MODE=ask
  case "${1:-}" in
    -y) UN_MODE=yes ;;
    -n) UN_MODE=dry ;;
    "") ;;
    *) die "用法:vgm uninstall [-n 只列出 | -y 不逐項詢問]" ;;
  esac
  HOME_REAL="$(cd "$HOME" && pwd -P)"

  # 1. 先關掉還在跑的 Windows 程式(只針對 vgm 自己的 Wine 環境)
  if [ "$UN_MODE" != dry ] && find_wine >/dev/null 2>&1 && [ -d "$WINEPREFIX" ]; then
    need_wine
    "$WINESERVER" -k 2>/dev/null || true
  fi

  # 2. 資料:Wine 環境(含已下載的遊戲與存檔)、自行下載的 Wine、紀錄
  remove_dir "$VGM_HOME" "vgm 資料(Windows 環境、遊戲、存檔、Wine)"
  # 3. 使用者自訂的設定檔與後端
  remove_dir "$VGM_CONFIG" "vgm 自訂設定"

  # 4. PATH 上的捷徑:只刪「指向這支腳本的符號連結」
  local dir link
  for dir in /opt/homebrew/bin /usr/local/bin "$HOME/bin" "$HOME/.local/bin"; do
    link="$dir/vgm"
    if [ -L "$link" ] && [ "$(readlink "$link")" = "$VGM_ROOT/vgm" ]; then
      say "捷徑:$link"
      if confirm "刪除?"; then rm -f "$link" && echo "  已刪除"; fi
    fi
  done

  # 5. setup 用 Homebrew 裝的 Game Porting Toolkit 與它的 tap
  if command -v brew >/dev/null && brew list --cask game-porting-toolkit >/dev/null 2>&1; then
    say "Homebrew cask:game-porting-toolkit(/Applications/Game Porting Toolkit.app)"
    if confirm "移除?"; then
      brew uninstall --cask "$WINE_CASK" || warn "移除失敗,請手動執行:brew uninstall --cask $WINE_CASK"
    fi
  fi
  if command -v brew >/dev/null && brew tap 2>/dev/null | grep -qx 'gcenx/wine'; then
    say "Homebrew tap:gcenx/wine"
    # 這個 tap 若還有其他已安裝的套件,brew 會自己拒絕
    if confirm "移除?"; then brew untap gcenx/wine || warn "tap 仍被其他套件使用,保留"; fi
  fi

  # 6. 專案目錄本身:不自動刪,避免誤刪你改過的東西
  say "剩下專案目錄本身,確認不需要後自行刪除:"
  echo "  rm -rf \"$VGM_ROOT\""
  echo "  (Rosetta 2、Homebrew、Mac 版 Steam 都沒有動)"
}

cmd_help() {
  cat <<EOF
vgm — 在 Apple Silicon Mac 上玩 Steam Windows 遊戲

  vgm setup                  一鍵安裝:Rosetta 2、Wine + D3DMetal、Windows 版 Steam
  vgm steam [參數...]        開啟 Steam
  vgm list                   列出已安裝的遊戲與 appid
  vgm play <appid> [參數...] 啟動遊戲(自動套用 profiles/<appid>.conf)
  vgm run [-p 設定檔] <exe>  不經 Steam 直接執行 exe
  vgm backend [list|install] 管理圖形後端
  vgm doctor                 檢查環境
  vgm log [行數]             顯示執行中的 Windows 程式與上次啟動的紀錄
  vgm kill                   關閉所有 Windows 程式
  vgm wine <參數...>         直接呼叫 Wine(例:vgm wine winecfg)
  vgm uninstall [-n|-y]      移除 vgm 安裝的所有東西(-n 只列出,-y 不逐項詢問)

環境變數:VGM_DEBUG=1 詳細紀錄、VGM_WINE 指定 Wine、VGM_GPTK 指定 Game Porting Toolkit、VGM_HOME 資料目錄(預設 ~/.vgm)
EOF
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
  setup | steam | play | run | list | backend | doctor | log | kill | wine | uninstall | help) "cmd_$cmd" "$@" ;;
  -h | --help) cmd_help ;;
  *) die "未知指令:$cmd(執行 vgm help 查看用法)" ;;
esac
